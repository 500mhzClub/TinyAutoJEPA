# --- Large Data Files (DO NOT COMMIT) ---
# Large datasets and weights. Keep Python scripts in python/data/ tracked.
python/data/*.npz
python/data/*.npy
python/data/*.pt
python/data/*.pth
python/data/*.ckpt
python/data/*.onnx
python/data/*.zip
python/data_*/*.npz
python/data_*/*.npy
python/data_*/*.pt
python/data_*/*.pth
python/data_*/*.ckpt
python/data_*/*.onnx
python/data_*/*.zip
*.pt
*.pth
*.ckpt
*.onnx
.cache

# --- Python ---
# Compiled python files (garbage)
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments ---
# Your local python sandbox
venv/
env/
.env
.venv/

# --- IDE Settings (Optional but recommended) ---
# User-specific settings for VS Code, PyCharm, etc.
.vscode/
.idea/
*.swp

# --- System ---
.DS_Store
Thumbs.db

# --- Logs & Monitoring ---
# If you add Tensorboard later
runs/
*.log
